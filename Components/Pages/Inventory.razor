@page "/inventory"
@rendermode InteractiveServer
@implements IDisposable
@using MealPlanner.Models
@using MealPlanner.Services
@using Microsoft.Extensions.Options
@inject InventoryService Svc
@inject InventoryChangeNotifier Notifier
@inject IReceiptScanner Scanner
@inject IOptions<ReceiptScanningOptions> ScanOptions
@inject ILogger<Inventory> Logger

<PageTitle>Inventory</PageTitle>

<h1>Kitchen Inventory</h1>
<p class="text-muted">What the kitchen has on hand. Claude reads and updates this too.</p>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label mb-1" for="new-name">Ingredient</label>
                @* @bind-Value:after, not a separate handler on the event: the
                   component binds on oninput internally, which is exactly what
                   AGENTS.md describes — the per-keystroke round trip drives
                   the Add button's disabled state, the matching and the
                   autofill, and it is deliberate. Enter with nothing arrowed
                   onto still adds, which is this page's rule and travels as a
                   callback rather than living in the widget. *@
                <IngredientCombobox Id="new-name" Placeholder="e.g. Coriander" MaxLength="100"
                                    @bind-Value="newName" @bind-Value:after="OnNameChanged"
                                    Suggestions="suggestions"
                                    OnPick="ApplySuggestion"
                                    OnEnterWithoutHighlight="AddAsync">
                    <OptionTemplate Context="item">
                        <span>@item.Name</span>
                        <span class="text-muted small">@Pretty(item.Category)</span>
                    </OptionTemplate>
                </IngredientCombobox>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1" for="new-category">Category</label>
                <select class="form-select" id="new-category"
                        @bind="newCategory" @bind:after="OnCategoryTouched">
                    @foreach (var c in Enum.GetValues<IngredientCategory>())
                    {
                        <option value="@c">@Pretty(c)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1" for="new-quantity">Quantity</label>
                <input class="form-control" id="new-quantity" placeholder="e.g. 2 bags"
                       @bind="newQuantity" @bind:after="OnQuantityTouched" maxlength="50"/>
            </div>
            <div class="col-md-2">
                @* "Update" once the name lands on an existing row: the
                   strongest available statement that Add is about to
                   overwrite something rather than create it. *@
                <button class="btn btn-primary w-100" @onclick="AddAsync"
                        disabled="@string.IsNullOrWhiteSpace(newName)">@(matchedItem is null ? "Add" : "Update")</button>
            </div>
        </div>
        @* Its own full-width line rather than a sixth column: the row above is
           already 4/3/3/2, and squeezing Notes in would leave it the same strip
           the row editor used to give it. This is the field's whole reason for
           being here. *@
        <div class="mt-2">
            <label class="form-label mb-1" for="new-notes">Notes</label>
            <input class="form-control" id="new-notes" placeholder="e.g. back of the top shelf"
                   @bind="newNotes" @bind:after="OnNotesTouched" maxlength="500"/>
        </div>
        @* Outside the row on purpose: the row is align-items-end, so anything
           added under the input inside its own column lifts that input out of
           line with the other three. Live, but deliberately not role=status —
           the add-result region below owns that role, and more than one
           element answering to it would break the page's own tests. *@
        <div class="name-hint" aria-live="polite">
            @if (matchedItem is not null)
            {
                @* The notes segment appears only when the note is actually
                   changing, unlike the two beside it which always render. A
                   fourth always-on clause makes this line long enough that
                   nobody reads it, and the line exists to warn about overwrites
                   — an unchanged note is not one. *@
                <span>Updating <strong>@matchedItem.Name</strong> — @HintCategory() · @HintQuantity()@HintNotes()</span>
            }
        </div>
        @* The live region stays in the DOM and only its contents change —
           screen readers announce mutations inside a region they already know
           about, not one that arrives with its text already in it. Empty, the
           wrapper has no height, so the margin lives on the alert. *@
        <div role="status">
            @if (statusMessage is not null)
            {
                @* The region announces either way; the colour is only for the
                   sighted reader, and "someone else deleted the row you were
                   editing" must not arrive dressed as a success. *@
                <div class="alert @(statusIsError ? "alert-warning" : "alert-success") py-2 mt-3 mb-0">@statusMessage</div>
            }
        </div>
    </div>
</div>

@if (ScanOptions.Value.Enabled)
{
    @* Below the add form, never above it: a household member who knows what
       they want types it, and the whole receipt path is the slower, chunkier
       one. The ordering is load-bearing for the page's own tests too — several
       reach for Find("button.btn-primary"), which returns the first match in
       document order, and that has to keep meaning Add. *@
    <div class="card mb-4 scan-card">
        <div class="card-body">
            @if (scanRows is null)
            {
                <div class="d-flex flex-wrap align-items-end gap-3">
                    <div class="flex-grow-1">
                        <label class="form-label mb-1" for="scan-file">Fill from a receipt</label>
                        @* Keyed on a counter so the control is a fresh element
                           after every scan. A file input fires no change event
                           when the same file is picked twice, so without this
                           a re-scan of the photo you just discarded does
                           nothing at all — which reads as a broken button.

                           accept filters what the picker offers, and is a
                           convenience for whoever is choosing rather than a
                           promise to the server — which checks the media type
                           and the size itself.

                           Deliberately no capture="environment". It reads like
                           the mobile-friendly choice, and it is the opposite:
                           it opens the camera *instead of* the picker, so a
                           receipt photographed an hour ago in the gallery
                           becomes unreachable. Without it a phone offers both,
                           camera included. *@
                        <InputFile @key="scanNonce" id="scan-file" class="form-control scan-file"
                                   accept="image/png,image/jpeg,image/webp,image/gif,application/pdf"
                                   disabled="@scanning"
                                   OnChange="OnReceiptChosenAsync"/>
                    </div>
                    @if (scanning)
                    {
                        <button class="btn btn-outline-secondary scan-cancel" @onclick="CancelScan">Cancel</button>
                    }
                </div>
                <p class="scan-help mb-0">
                    @if (scanning)
                    {
                        <span>Reading @scanFileName… this takes a few seconds.</span>
                    }
                    else
                    {
                        <span>A photo or a PDF. Nothing is written until you have looked at it.</span>
                    }
                </p>
            }
            else
            {
                <div class="d-flex flex-wrap align-items-baseline gap-2 mb-2">
                    <h2 class="h6 mb-0">@Plural(scanRows.Count, "line") from @scanFileName</h2>
                    <span class="scan-help ms-auto">@keptCount of @scanRows.Count selected</span>
                </div>
                @* A list rather than a table on purpose: the page's one <table>
                   is the inventory itself, and the tests select inside tbody to
                   find the row editor. A second tbody full of inputs would make
                   every one of those selectors ambiguous the moment a receipt
                   was open. *@
                <ul class="scan-rows list-unstyled mb-0">
                    @for (var i = 0; i < scanRows.Count; i++)
                    {
                        var row = scanRows[i];
                        var match = ScanMatch(row);
                        var duplicateOf = FirstUseOf(i);
                        var position = i + 1;
                        <li class="scan-row @(row.Keep ? null : "scan-row-dropped")" @key="row">
                            <input class="form-check-input scan-keep" type="checkbox"
                                   aria-label="Add @DisplayName(row.Name, position)"
                                   @bind="row.Keep"/>
                            @* The department the receipt filed this line under
                               — context beside the row, so a heading the model
                               welded into a name anyway has its double sitting
                               right there to be seen. Always rendered, or the
                               name boxes stop lining up between rows. *@
                            <span class="scan-department" title="@row.Department">@row.Department</span>
                            @* oninput on both boxes, the same deliberate
                               per-keystroke round trip the add form makes: the
                               badge beside them says what this row is about to
                               do to the kitchen, and a badge that lags a
                               keystroke behind is worse than none. *@
                            <input class="form-control form-control-sm scan-name" maxlength="100"
                                   aria-label="Name for line @position"
                                   @ref="scanNameRefs[row]"
                                   @bind="row.Name" @bind:event="oninput"/>
                            <input class="form-control form-control-sm scan-quantity" maxlength="50"
                                   placeholder="e.g. 2 bags"
                                   aria-label="Quantity for @DisplayName(row.Name, position)"
                                   @bind="row.Quantity" @bind:event="oninput"/>
                            <span class="scan-effect">
                                @if (string.IsNullOrWhiteSpace(row.Name))
                                {
                                    <span class="badge text-bg-secondary">No name</span>
                                }
                                else if (duplicateOf is { } firstLine)
                                {
                                    @* Ahead of Replaces and New on purpose: a
                                       second row of the same name is the more
                                       surprising fact, and what the inventory
                                       holds is already being said by the row
                                       this one collides with. *@
                                    <span class="badge text-bg-danger">Duplicate</span>
                                    <span class="scan-effect-detail">
                                        Same name as line @firstLine — the second would overwrite the first
                                    </span>
                                }
                                else if (match is null)
                                {
                                    @* The model's names are not stable between
                                       scans of one photograph, so "no exact
                                       match" splits in two: a name that merely
                                       *spells* a stocked row differently, and a
                                       genuinely new one. Only a person can say
                                       which, so the near match is an offer with
                                       a button, never an automatic rewrite. *@
                                    if (ScanNearMatch(row) is { } near)
                                    {
                                        <span class="badge text-bg-info">Looks like</span>
                                        <span class="scan-effect-detail">
                                            @near.Name is stocked —
                                            <button type="button" class="btn btn-link btn-sm p-0 scan-adopt"
                                                    aria-label="Use the stocked name @near.Name for line @position"
                                                    @onclick="() => AdoptStockedName(row, near)">use that name</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-success">New</span>
                                    }
                                }
                                else if (IsNoOp(match, row))
                                {
                                    @* A row whose quantity already matches would
                                       write nothing, and "Replaces · 1 kg → 1 kg"
                                       warns about an overwrite that is not one.
                                       Approximate on purpose, exactly as the
                                       Replaces badge beside it is: the service
                                       normalizes before it compares, and this is
                                       derived on every render from whatever the
                                       kitchen holds right now. *@
                                    <span class="badge text-bg-secondary">No change</span>
                                    <span class="scan-effect-detail">
                                        @match.Name is already @DisplayQuantity(match.Quantity)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-warning">Replaces</span>
                                    <span class="scan-effect-detail">
                                        @match.Name: @DisplayQuantity(match.Quantity) → @DisplayQuantity(row.Quantity)
                                    </span>
                                }
                            </span>
                        </li>
                    }
                </ul>
                <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                    <button class="btn btn-primary scan-confirm" @onclick="ConfirmScanAsync"
                            disabled="@(keptCount == 0 || confirming)">
                        Add @Plural(keptCount, "line")
                    </button>
                    <button class="btn btn-outline-secondary scan-discard" @onclick="DiscardScan"
                            disabled="@confirming">Discard</button>
                    <span class="scan-help ms-auto">Categories are filled in afterwards.</span>
                </div>
            }
            @if (scanError is not null)
            {
                @* role=alert, not a second role=status. The add form above owns
                   this page's one status region, and a second element answering
                   to it breaks the page's own tests — the same line the row
                   editor's error draws. *@
                <div role="alert" class="alert alert-warning py-2 mt-3 mb-0 scan-error">@scanError</div>
            }
        </div>
    </div>
}

@if (items is null)
{
    <p><em>Loading…</em></p>
}
else if (items.Count == 0)
{
    <p class="text-muted">Nothing tracked yet. Add something above, or ask Claude to stock the kitchen.</p>
}
else
{
    @foreach (var group in items.GroupBy(i => i.Category).OrderBy(g => g.Key))
    {
        var category = group.Key;
        var isOpen = expandedCategories.Contains(category);
        @* Key the group too: without it, deleting the last item in a category
           shifts the ones below onto the DOM of the group above, which lands a
           focus ring on a header nobody clicked — the row bug one level up. *@
        <div class="category-group mt-3" @key="category">
            @* Heading wraps the button, not the reverse: a button takes phrasing
               content only, and the categories belong in the heading outline.
               aria-expanded must be a string — Blazor drops a false bool
               attribute entirely, so the collapsed state went unannounced. *@
            <h5 class="mb-0">
                <button type="button"
                        class="category-toggle btn btn-link text-decoration-none p-0 d-flex align-items-center gap-2 w-100"
                        @onclick="() => ToggleCategory(category)"
                        aria-expanded="@(isOpen ? "true" : "false")">
                    <span class="category-chevron @(isOpen ? "open" : null)" aria-hidden="true">▸</span>
                    <span class="category-label">@Pretty(category)</span>
                    <span class="text-muted small">(@group.Count())</span>
                </button>
            </h5>
            @if (isOpen)
            {
                <table class="table table-sm align-middle mt-2">
                    <tbody>
                    @foreach (var item in group.OrderBy(i => i.Name))
                    {
                        var editing = editingId == item.Id;
                        @* Key by id so a deleted row's DOM (and its focus) is
                           torn down rather than patched onto the next item —
                           otherwise the blue ring on the action button sticks to
                           the survivor. *@
                        <tr @key="item.Id" class="@(editing ? "row-editing" : null)">
                            @if (editing)
                            {
                                @* One spanning cell, not five. The editor used to
                                   sit in the same columns as the view rows, and
                                   its button cluster made the shrink-to-fit
                                   action column grow — which took the width from
                                   the Notes column and shifted every other
                                   pencil in the group sideways. Out of the
                                   columns entirely, it cannot move anything, and
                                   Notes gets room from its own layout rather
                                   than from whatever three sized columns left
                                   over.

                                   Every text box binds on oninput, the same
                                   deliberate per-keystroke round trip the add
                                   form uses. Two things ride on it: Save's
                                   disabled state, and Enter — keydown fires
                                   before a plain onchange would have committed,
                                   so Enter-to-save would otherwise write the
                                   value from before the last character. *@
                                <td colspan="5">
                                    <div class="row-editor">
                                        <input class="form-control form-control-sm edit-name"
                                               @ref="editNameInput"
                                               aria-label="Name for @item.Name" maxlength="100"
                                               @bind="editName" @bind:event="oninput"
                                               @bind:after="() => editNameTouched = true"
                                               @onkeydown="OnEditKeyDownAsync"/>
                                        <input class="form-control form-control-sm edit-quantity"
                                               placeholder="e.g. 2 bags" maxlength="50"
                                               aria-label="Quantity for @item.Name"
                                               @bind="editQuantity" @bind:event="oninput"
                                               @bind:after="() => editQuantityTouched = true"
                                               @onkeydown="OnEditKeyDownAsync"/>
                                        @* value=/@onchange rather than @bind: see
                                           OnEditCategoryChanged. *@
                                        <select class="form-select form-select-sm edit-category"
                                                value="@editCategory"
                                                aria-label="Category for @item.Name"
                                                @onchange="OnEditCategoryChanged">
                                            @foreach (var c in Enum.GetValues<IngredientCategory>())
                                            {
                                                <option value="@c">@Pretty(c)</option>
                                            }
                                        </select>
                                        <input class="form-control form-control-sm edit-notes"
                                               placeholder="Notes" maxlength="500"
                                               aria-label="Notes for @item.Name"
                                               @bind="editNotes" @bind:event="oninput"
                                               @bind:after="() => editNotesTouched = true"
                                               @onkeydown="OnEditKeyDownAsync"/>
                                        @* Delete sits apart from Cancel, and never
                                           under a ✕: in an edit row that glyph reads
                                           as "cancel" everywhere else in the world,
                                           so the same shape would mean "throw this
                                           away" and "throw this row away" one
                                           mis-click apart. The gap is the point. *@
                                        <div class="row-editor-actions">
                                            <button class="btn btn-outline-danger btn-sm item-remove me-3"
                                                    @onclick="() => DeleteAsync(item.Id)"
                                                    aria-label="Remove @item.Name">🗑</button>
                                            <button class="btn btn-primary btn-sm item-save"
                                                    @onclick="SaveEditAsync"
                                                    disabled="@string.IsNullOrWhiteSpace(editName)">Save</button>
                                            <button class="btn btn-outline-secondary btn-sm item-cancel"
                                                    @onclick="CancelEdit">Cancel</button>
                                        </div>
                                    </div>
                                </td>
                            }
                            else
                            {
                                <td style="width: 30%">@item.Name</td>
                                <td style="width: 25%">@item.Quantity</td>
                                <td style="width: 20%" class="text-muted small">@Pretty(item.Category)</td>
                                <td class="text-muted small">@item.Notes</td>
                                @* Fixed width, right-aligned. Not width:1% — that
                                   is shrink-to-fit, so a long note in any sibling
                                   row re-flows this column too and drags the
                                   pencils with it. The editor is no longer the
                                   only thing that could move them. *@
                                <td class="item-actions">
                                    <button class="btn btn-outline-secondary btn-sm item-edit"
                                            @ref="pencils[item.Id]"
                                            @onclick="() => BeginEdit(item)"
                                            aria-label="Edit @item.Name">✎</button>
                                </td>
                            }
                        </tr>
                        @if (editing && editError is not null)
                        {
                            @* role=alert, not role=status: the add form above
                               owns this page's one status region, and a second
                               element answering to it breaks the page's own
                               tests. alert is what an error wants anyway. *@
                            var errorKey = $"edit-error-{item.Id}";
                            <tr @key="errorKey">
                                <td colspan="5" class="pt-0 border-0">
                                    <div role="alert" class="alert alert-danger py-1 px-2 mb-0 small">@editError</div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            }
        </div>
    }
}

@code {
    private List<InventoryItem>? items;
    private string newName = string.Empty;
    private IngredientCategory newCategory = IngredientCategory.Other;
    private string newQuantity = string.Empty;
    private string newNotes = string.Empty;
    private string? statusMessage;
    private bool statusIsError;
    private CancellationTokenSource? statusCts;

    // How long the status line stays up follows the message: a flat three
    // seconds was long enough for the add form's one-liners and lost a scan's
    // multi-clause summary entirely — a status sentence made *true* (the
    // Unchanged fix) and then cleared before anyone reads it is only half
    // fixed. ~15 chars/s is an unhurried reading pace; the floor keeps short
    // lines from feeling blinky, the ceiling keeps any message from looking
    // stuck.
    private static TimeSpan StatusDurationFor(string message) =>
        TimeSpan.FromSeconds(Math.Clamp(2 + message.Length / 15.0, 4.0, 12.0));
    // Categories start collapsed; only ones the user opens stay open across
    // live refreshes (MCP / other circuits). HashSet so toggle is O(1).
    private readonly HashSet<IngredientCategory> expandedCategories = [];

    // Name-matching state. Derived from `items` and `newName`, but stored
    // rather than recomputed at render time so the matcher runs once per
    // change, not per paint. The highlight and the dismissal live inside
    // IngredientCombobox — they are the widget's, not the form's.
    private IReadOnlyList<InventoryItem> suggestions = [];
    private InventoryItem? matchedItem;  // the row an exact name is editing
    // Autofill writes only into boxes the user has left alone. Both flip the
    // moment the user commits a value of their own, and reset on add.
    private bool categoryTouched;
    private bool quantityTouched;
    private bool notesTouched;

    // Row editor state. The draft lives in these fields rather than in the DOM,
    // and that is not a style choice: the notifier replaces `items` on every
    // write from anywhere — the auto-categorizer fires a few seconds after each
    // add — and the table is grouped by category, so a row whose category moves
    // is re-rendered under a different @key'd group and its DOM is torn down.
    // Fields survive that; input values would not. Focus does not survive it
    // either, which is the price of the grouping and is accepted.
    private int? editingId;
    private string editName = string.Empty;
    private string editQuantity = string.Empty;
    private IngredientCategory editCategory;
    private string editNotes = string.Empty;
    // Shown under the row being edited, not in the page's status region.
    private string? editError;
    // Per-field, and the same idea as the add form's categoryTouched: a box the
    // user has typed in is theirs until they save or cancel, and a box they have
    // not is still just a picture of the row. Without these, opening an editor
    // froze a snapshot of all four fields and Save wrote the whole snapshot back
    // — so a category the auto-categorizer (or another tab) moved in the
    // meantime got silently reverted by a user who only meant to fix a note.
    private bool editNameTouched;
    private bool editQuantityTouched;
    private bool editCategoryTouched;
    private bool editNotesTouched;
    // Opening an editor removes the pencil that was clicked, so focus had
    // nowhere to land and fell to <body>. That is not cosmetic: the row's Enter
    // and Escape handlers live on its inputs, so Escape did nothing at all until
    // the user clicked into a field, and a keyboard user had to tab back through
    // the nav and the whole add form to reach the row they had just opened.
    private ElementReference editNameInput;
    private bool focusEditName;
    // Closing an editor loses focus the same way opening one did — the inputs go
    // and the pencil comes back. @ref takes any assignable expression, an
    // indexer included, so one capture per row costs a dictionary rather than
    // the pencil markup duplicated across a conditional.
    private readonly Dictionary<int, ElementReference> pencils = [];
    private int? focusPencilId;

    // Receipt scanning. `scanRows` being non-null is what "a review is open"
    // means, so there is one place to look and no second flag to disagree with
    // it. The rows live here rather than in the DOM for the same reason the row
    // editor's draft does, and it bites harder: confirming writes them one at a
    // time, and every write publishes, so RefreshAsync and a re-render land
    // between one row and the next. A name corrected by hand must survive that.
    private List<ScanRow>? scanRows;
    private bool scanning;
    private bool confirming;
    private string? scanError;
    private string? scanFileName;
    private CancellationTokenSource? scanCts;
    // Bumped after every scan so the <InputFile> is a new element each time —
    // see the @key on it.
    private int scanNonce;
    // One capture per review row's name box — the pencils trick one card down:
    // @ref takes any assignable expression, an indexer included. Blazor never
    // clears a capture when its element goes and circuits are long-lived, so
    // every site that closes or prunes the review clears this too.
    private readonly Dictionary<ScanRow, ElementReference> scanNameRefs = [];
    // The review row whose name box takes focus on the next render. Adopting a
    // stocked spelling removes the very button that was clicked, so without
    // this focus falls to <body> — the row editor's Escape-did-nothing bug,
    // one card down.
    private ScanRow? focusScanName;

    private int keptCount => scanRows?.Count(r => r.Keep && !string.IsNullOrWhiteSpace(r.Name)) ?? 0;

    /// <summary>
    /// One proposed line, as edited. A class rather than a record so the boxes
    /// can bind straight to it, and so @key has a stable reference to hold
    /// while the name in it is being retyped.
    /// </summary>
    private sealed class ScanRow
    {
        public bool Keep { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Quantity { get; set; } = string.Empty;
        // Context, not data — the receipt's department heading, shown muted
        // beside the row and written nowhere. Not editable: corrections belong
        // in the name box.
        public string? Department { get; init; }
    }

    protected override void OnInitialized()
    {
        // The single refresh path for this page: out-of-circuit writers (MCP /
        // Claude) and this circuit's own handlers all publish here, and the
        // re-render happens on the circuit's sync context so the table tracks
        // the kitchen live. The handlers below deliberately do not refresh
        // themselves — the service awaits this publish, so by the time a write
        // returns the table is already current (issue #1).
        Notifier.Subscribe(OnInventoryChangedAsync);
        Logger.LogDebug("Inventory initialized. instance={Instance}", GetHashCode());
    }

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    // Returns the task rather than dropping it, so a failed refresh surfaces to
    // the notifier's guard and gets logged instead of vanishing.
    private Task OnInventoryChangedAsync(InventoryChange change) =>
        InvokeAsync(async () =>
        {
            // PreviousCategory is set only by SetCategoryAsync, i.e. only when a
            // row has just moved groups — the auto-categorizer's second write a
            // few seconds after an add, or someone's dropdown. Open the
            // destination, or the item silently vanishes into a collapsed
            // category right after the user watched it land in Other.
            if (change.PreviousCategory is not null)
            {
                ExpandCategory(change.Category);
            }

            await RefreshAsync();
            // The row the name box is pointing at may be the one that just
            // changed — an MCP tool or another tab can create it, delete it or
            // re-quantify it. Re-deriving keeps the hint honest; leaving it
            // stale would put "Updating Salt · 1 box" above an empty Quantity
            // field that Add would then write back as empty, which is the
            // exact footgun this whole feature exists to close.
            SyncToName();
            SyncDraftToRow();
            DropEditIfRowIsGone();
            StateHasChanged();
        });

    private async Task RefreshAsync()
    {
        items = await Svc.GetAllAsync();
        // Blazor does not clear an element-ref capture when the element goes, so
        // without this the dictionary keeps a stale entry per deleted row for
        // the life of the circuit — and these circuits are long-lived.
        var live = items.Select(i => i.Id).ToHashSet();
        foreach (var id in pencils.Keys.Where(id => !live.Contains(id)).ToList())
        {
            pencils.Remove(id);
        }
    }

    // The one place the matching rule lives. Called from the name box's
    // @bind:after and from the notifier above, so a live write and a keystroke
    // land the form in the same state.
    private void SyncToName()
    {
        // A fresh list every time, which is also how IngredientCombobox knows
        // to drop its highlight — an index into the old list points at the
        // wrong row, and Enter must go back to meaning "add" until the user
        // arrows on purpose.
        suggestions = IngredientMatcher.Suggest(items, newName);

        var match = IngredientMatcher.ExactMatch(items, newName);
        if (match is not null)
        {
            if (!categoryTouched) newCategory = match.Category;
            if (!quantityTouched) newQuantity = match.Quantity;
            // Notes autofills for the same reason the other two do, and it
            // matters more here: Update writes what is in the box, so a note
            // left un-filled would be an empty string written over a real one.
            if (!notesTouched) newNotes = match.Notes ?? string.Empty;
        }
        else if (matchedItem is not null)
        {
            // Only on the match → no-match transition. A name that never
            // matched anything must not have the form emptied out underneath
            // it while the user is still typing it.
            if (!categoryTouched) newCategory = IngredientCategory.Other;
            if (!quantityTouched) newQuantity = string.Empty;
            if (!notesTouched) newNotes = string.Empty;
        }

        matchedItem = match;
    }

    private void OnNameChanged() => SyncToName();

    private void OnCategoryTouched() => categoryTouched = true;

    private void OnQuantityTouched() => quantityTouched = true;

    private void OnNotesTouched() => notesTouched = true;

    private void ApplySuggestion(InventoryItem item)
    {
        newName = item.Name;
        // An explicit pick clears all three flags: choosing a row by hand says
        // "I mean this one" in a way that typing a near-miss never does.
        categoryTouched = false;
        quantityTouched = false;
        notesTouched = false;
        SyncToName();
        // The combobox closes itself afterwards. It has to be afterwards: the
        // name is an exact match now, so Suggest drops it, but a longer name
        // may still have it as a prefix ("Salt" → "Salted butter").
    }

    private void ToggleCategory(IngredientCategory category)
    {
        if (!expandedCategories.Remove(category))
        {
            expandedCategories.Add(category);
        }
    }

    // Ensure the destination is visible so the user sees the row land there.
    private void ExpandCategory(IngredientCategory category) =>
        expandedCategories.Add(category);

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        var change = await Svc.UpsertAsync(newName, newQuantity, newCategory, newNotes);
        // Use the returned category: upsert can land on an existing row whose
        // category differs from what the form still held. Still needed despite
        // the notifier: an upsert reports no PreviousCategory, so a create has
        // nothing there to recognise as a move.
        ExpandCategory(change.Category);
        // Clear the form before showing the status, never after: the dismissal
        // delay used to be awaited here, which left the just-added name sitting
        // in the box for a full three seconds and then wiped whatever had been
        // typed in the meantime.
        newName = string.Empty;
        newQuantity = string.Empty;
        newNotes = string.Empty;
        // Reset too: a category left over from the last add silently attached
        // itself to the next ingredient, which is most of why everything ended
        // up needing sorting out by hand in the first place.
        newCategory = IngredientCategory.Other;
        // After the await, never before: the upsert above publishes, and the
        // notifier handler runs SyncToName() while newName still holds the
        // name that was typed. Resetting first would just be undone.
        ResetMatchState();
        ShowStatus(change.Describe());
    }

    private void ResetMatchState()
    {
        // Emptying the list and the box is the whole of it — the combobox
        // drops its own highlight when the list changes, and reopens for the
        // next keystroke because the box is now blank.
        suggestions = [];
        matchedItem = null;
        categoryTouched = false;
        quantityTouched = false;
        notesTouched = false;
    }

    // Ephemeral success line under the add form. A new add cancels the previous
    // timer so rapid entry never leaves a stale message behind.
    private void ShowStatus(string message, bool isError = false)
    {
        statusCts?.Cancel();
        statusCts?.Dispose();
        statusCts = new CancellationTokenSource();

        statusMessage = message;
        statusIsError = isError;
        // Paint it now. A handler re-renders only at its first incomplete await
        // and again on completion, so a message set and cleared between those
        // two points never reaches the browser — which is exactly what happened
        // once the write above yielded for real (a second circuit subscribed to
        // the notifier is enough to move the first yield earlier).
        StateHasChanged();

        // The one deliberately unawaited call on this page. AGENTS.md bans
        // fire-and-forget because it loses the re-render and swallows
        // exceptions; both are handled explicitly in the method below, and the
        // timer has to outlive the handler or the add form freezes again.
        _ = DismissStatusAsync(StatusDurationFor(message), statusCts.Token);
    }

    private async Task DismissStatusAsync(TimeSpan duration, CancellationToken token)
    {
        try
        {
            await Task.Delay(duration, token);
            statusMessage = null;
            // Nothing else is rendering by now — the handler that showed the
            // message finished long ago — so ask for the pass ourselves.
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // The next add, or disposal — expected.
        }
        catch (Exception ex)
        {
            // Nothing awaits this task, so an exception here would vanish. A
            // stale alert is harmless; losing the reason for it is not.
            Logger.LogWarning(ex, "Could not clear the inventory status message");
        }
    }

    private void BeginEdit(InventoryItem item)
    {
        editingId = item.Id;
        editName = item.Name;
        editQuantity = item.Quantity;
        editCategory = item.Category;
        editNotes = item.Notes ?? string.Empty;
        editError = null;
        editNameTouched = false;
        editQuantityTouched = false;
        editCategoryTouched = false;
        editNotesTouched = false;
        focusEditName = true;
    }

    // The editor's inputs do not exist until the render this flag survives into,
    // so the focus call has to wait for it rather than happen in BeginEdit.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var target = NextFocusTarget();
        if (target is not { } element) return;

        try
        {
            await element.FocusAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit went away between render and focus. Nothing to do,
            // and nothing worth logging — the page is gone.
        }
    }

    // Both flags are cleared whether or not a target turns up, so a row that
    // vanished between the click and this render doesn't leave the page trying
    // to focus it again on every subsequent paint.
    private ElementReference? NextFocusTarget()
    {
        if (focusEditName)
        {
            focusEditName = false;
            // The row can be gone already — an out-of-circuit delete between the
            // click and this render — in which case there is no input to focus
            // and DropEditIfRowIsGone has already closed the editor.
            return editingId is null ? null : editNameInput;
        }

        if (focusPencilId is { } id)
        {
            focusPencilId = null;
            return pencils.TryGetValue(id, out var pencil) ? pencil : null;
        }

        if (focusScanName is { } adopted)
        {
            focusScanName = null;
            // The row can be gone — the review pruned or closed between the
            // click and this render — in which case there is nothing to focus.
            return scanNameRefs.TryGetValue(adopted, out var nameBox) ? nameBox : null;
        }

        return null;
    }

    private void CancelEdit()
    {
        focusPencilId = editingId;
        editingId = null;
        editError = null;
    }

    // The counterpart to DropEditIfRowIsGone, for a row that changed rather than
    // vanished. Only boxes the user has left alone follow the row; anything they
    // have typed in is theirs. Without this the editor shows a row filed under
    // one category heading while its own dropdown reads another, and Save then
    // writes the stale one back over whoever moved it.
    private void SyncDraftToRow()
    {
        if (editingId is not { } id || items?.FirstOrDefault(i => i.Id == id) is not { } row)
        {
            return;
        }

        if (!editNameTouched) editName = row.Name;
        if (!editQuantityTouched) editQuantity = row.Quantity;
        if (!editCategoryTouched) editCategory = row.Category;
        if (!editNotesTouched) editNotes = row.Notes ?? string.Empty;
    }

    private async Task SaveEditAsync()
    {
        // Save is disabled on a blank name, but Enter reaches here too.
        if (editingId is not { } id || string.IsNullOrWhiteSpace(editName)) return;

        var change = await Svc.UpdateItemAsync(id, editName, editQuantity, editCategory, editNotes);
        if (change.Kind == ChangeKind.NameTaken)
        {
            // Stay in edit mode with the draft untouched. The user has to see
            // which name clashed, and making them retype the row to find out
            // would be worse than the collision. Nothing was published, so the
            // table below is exactly as they left it.
            editError = change.Describe();
            return;
        }

        // Only when the row stayed put. A save that changed the category
        // relocates the row to another group, often off-screen, and FocusAsync
        // scrolls its target into view — so restoring focus there would yank the
        // page after the row. Restoring focus means putting the user back where
        // they were, and once the row has moved there is no such place; the two
        // alternatives are both worse, since preventScroll would leave focus on
        // something invisible. Falling back to <body> costs a keyboard user their
        // place in the tab order, which is the lesser harm and is why the
        // scroll-free path wins here.
        //
        // A rename that re-sorts the row a long way inside its own group has the
        // same shape, and is not handled: there is no server-side notion of where
        // a row landed, and the distance is bounded by one group.
        focusPencilId = change.PreviousCategory is null ? id : null;
        editingId = null;
        editError = null;
        // No RefreshAsync: the write above published, and the notifier handler
        // has already re-read and re-rendered by the time we get here (issue #1).
        // No ExpandCategory either — a save that moved the row carries
        // PreviousCategory, which that same handler acts on.
        ShowStatus(change.Describe(), isError: change.Kind == ChangeKind.NotFound);
    }

    // Enum.IsDefined is not redundant with Enum.TryParse: TryParse accepts "99"
    // and hands back an undefined IngredientCategory, which would reach the
    // database as the string "99". This is the guard AGENTS.md names, carried
    // over from the live select this editor replaced — the value now lands in a
    // draft first, so without it a hand-crafted <option> survives until Save.
    //
    // @bind would in fact also be safe — BindConverter rejects "99" outright,
    // verified rather than assumed — but that is a framework detail nothing in
    // this repo documents or tests. The page validates its own input.
    private void OnEditCategoryChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<IngredientCategory>(e.Value?.ToString(), out var category)
            && Enum.IsDefined(category))
        {
            editCategory = category;
            editCategoryTouched = true;
        }
    }

    private async Task OnEditKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Enter":
                await SaveEditAsync();
                break;
            case "Escape":
                CancelEdit();
                break;
        }
    }

    // Someone else — another tab, an MCP tool — removed the row that is open for
    // editing. Say so rather than letting the draft disappear with the row:
    // losing typed text is bad, losing it without a word is worse.
    private void DropEditIfRowIsGone()
    {
        if (editingId is not { } id || items is null || items.Any(i => i.Id == id))
        {
            return;
        }

        var name = editName;
        editingId = null;
        editError = null;
        ShowStatus($"\"{name}\" was removed while you were editing it", isError: true);
    }

    private async Task DeleteAsync(int id)
    {
        // Leave edit mode before the write, not after: DeleteAsync publishes,
        // and the guard above would otherwise announce "removed while you were
        // editing it" for a removal the user just asked for themselves.
        editingId = null;
        editError = null;
        await Svc.DeleteAsync(id);
    }

    // A receipt was chosen. Reads it into memory and hands it to the scanner;
    // nothing is written, and nothing touches this machine's disk.
    private async Task OnReceiptChosenAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        scanError = null;
        scanRows = null;
        scanNameRefs.Clear();
        focusScanName = null;
        scanFileName = file.Name;

        if (!ReceiptFile.IsSupportedMediaType(file.ContentType))
        {
            // The accept attribute filters the picker; it does not constrain
            // what arrives. A HEIC from an iPhone is the realistic case, and
            // saying so beats a schema-shaped failure ten seconds later.
            scanError = $"Can't read {DisplayFileName(file.ContentType)} files — use a JPEG, PNG or PDF.";
            scanNonce++;
            return;
        }

        if (file.Size > ScanOptions.Value.MaxBytes)
        {
            // Not integer division on either half: at 5,767,168 bytes against a
            // 5 MB cap that rendered "That file is 5 MB. The limit is 5 MB",
            // which is the message a rejection most often produces — just-over
            // is the common case, not a wildly oversized file.
            scanError = $"That file is {file.Size / 1024.0 / 1024.0:0.#} MB. "
                + $"The limit is {ScanOptions.Value.MaxBytes / 1024.0 / 1024.0:0.#} MB — try a smaller photo.";
            scanNonce++;
            return;
        }

        scanning = true;
        // Held locally as well as in the field: the checks after each await ask
        // "was *this* scan cancelled", and the field may by then belong to the
        // next one.
        var cts = new CancellationTokenSource();
        scanCts = cts;

        // One try/finally from the moment the field is set, never two. Split in
        // two, the read's own catch clauses returned past the finally below —
        // leaving the token source undisposed and, worse, scanCts non-null while
        // scanning was false, which is the state everything else here reads as
        // "a scan is live".
        try
        {
            byte[] content;

            try
            {
                using var buffer = new MemoryStream();
                // maxAllowedSize must be passed: the default is 512KB, which
                // every photograph exceeds. The check above is the real limit;
                // this repeats it because OpenReadStream trusts nothing either.
                await using (var stream = file.OpenReadStream(ScanOptions.Value.MaxBytes, cts.Token))
                {
                    await stream.CopyToAsync(buffer, cts.Token);
                }
                content = buffer.ToArray();
            }
            catch (OperationCanceledException)
            {
                // Cancel, or the circuit going away mid-upload.
                return;
            }
            catch (Exception ex)
            {
                // A browser that dropped the upload, or a file that vanished
                // under it. The scanner never saw this one, so its own logging
                // cannot.
                Logger.LogWarning(ex, "Could not read the uploaded receipt");
                scanError = "That file couldn't be read. Try choosing it again.";
                return;
            }

            var result = await Scanner.ScanAsync(
                new ReceiptFile(content, file.ContentType, file.Name), cts.Token);

            if (cts.IsCancellationRequested)
            {
                // Cancel is answered here, not only by the token: a scan that
                // finished while the click was in flight comes back with real
                // lines and no exception to catch. Opening a review out of one
                // the user has just called off is the same bug as ignoring the
                // button — they asked for nothing to happen.
            }
            else if (result.Lines.Count == 0)
            {
                // The scanner does not throw — an empty list is the whole of
                // the failure signal, and the log holds the reason. From here
                // "nothing came back" and "nothing legible on it" are the same
                // event, so the message covers both without guessing.
                scanError = "Nothing readable on that one. Try a flatter photo, "
                    + "or add the items by hand above.";
            }
            else
            {
                // Names already proposed, so a repeated line arrives unticked.
                // The prompt asks for one entry per thing with a count, but a
                // guard that only holds when the model complies is not a guard
                // — and the cost of it not holding is a purchase silently
                // overwriting its own twin.
                var proposed = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

                scanRows = result.Lines
                    .Select(line =>
                    {
                        var first = proposed.Add(line.Name.Trim());
                        return new ScanRow
                        {
                            // Non-food, duplicates and near matches of a
                            // stocked row all arrive unticked rather than
                            // dropped: each is a guess about someone else's
                            // shopping, and a greyed row costs one click to
                            // disagree with where a missing one leaves no
                            // recourse. The near-match untick is the Duplicate
                            // rationale pointed at the inventory instead of
                            // the receipt — confirming "Canard cat A" as-is
                            // stocks the kitchen twice, and adopting the
                            // stocked spelling re-ticks the row in the same
                            // click.
                            Keep = line.IsFood && first
                                && IngredientMatcher.NearMatch(items, line.Name) is null,
                            Name = line.Name,
                            Quantity = line.Quantity,
                            Department = line.Department,
                        };
                    })
                    .ToList();

                // Beside the review, not instead of it. A receipt longer than
                // MaxLines, or entries the parser could make nothing of, leave
                // the household looking at a list that is quietly short — the
                // same silence the prompt's heading rule exists to prevent one
                // step earlier. The alert region already renders alongside an
                // open review, so this needs no second element.
                scanError = result.Warning;
            }
        }
        catch (OperationCanceledException)
        {
            // Cancel, or disposal. Nothing to say — the user asked for it.
        }
        finally
        {
            scanning = false;
            // The local one, and the field only while it is still this scan's —
            // the same reason the local copy exists at all.
            cts.Dispose();
            if (ReferenceEquals(scanCts, cts))
            {
                scanCts = null;
            }
            scanNonce++;
        }
    }

    private void CancelScan()
    {
        scanCts?.Cancel();
        // Not scanning = false here: the handler's finally does that, and doing
        // it twice would let a second file be chosen while the first process is
        // still being killed.
    }

    private void DiscardScan()
    {
        scanRows = null;
        scanError = null;
        scanNameRefs.Clear();
        focusScanName = null;
    }

    // What this row would do to the kitchen if confirmed. Derived on every
    // render rather than stored with the row, so a name another tab creates
    // mid-review flips the badge from New to Replaces on its own — the same
    // reason SyncToName runs from the notifier as well as from the name box.
    private InventoryItem? ScanMatch(ScanRow row) => IngredientMatcher.ExactMatch(items, row.Name);

    // Derived per render for the same reason as ScanMatch: a row another tab
    // creates mid-review can turn a New badge into a Looks-like on its own.
    private InventoryItem? ScanNearMatch(ScanRow row) => IngredientMatcher.NearMatch(items, row.Name);

    // The person just said "this line is that row": take the stocked spelling,
    // and tick the line — a near match arrives unticked, so the click that
    // fixes the name is also the one that selects it. The badge re-derives on
    // the render this triggers: ExactMatch now hits, so it reads Replaces or
    // No change — or Duplicate, when an earlier line already carries the
    // adopted name, which is correct and exactly what the review is for.
    private void AdoptStockedName(ScanRow row, InventoryItem match)
    {
        row.Name = match.Name;
        row.Keep = true;
        focusScanName = row;
    }

    // Whether confirming this row would come back Unchanged. Trimmed, because
    // that is the only normalization InventoryService applies to a quantity that
    // is inside the length clamp, and the clamp is already on the box.
    private static bool IsNoOp(InventoryItem match, ScanRow row) =>
        match.Quantity.Trim() == row.Quantity.Trim();

    /// <summary>
    /// The 1-based position of the first earlier row already holding this row's
    /// name, or null when this is the first of its name.
    /// <para>
    /// The badge beside a row compares it to the <em>inventory</em>, which says
    /// nothing about the rest of the receipt — and a real till receipt rings the
    /// same thing up on several lines all the time. Both rows showed "New", and
    /// confirming wrote the first and then silently updated it with the second:
    /// two pork loins bought, one row in the kitchen, and a status line
    /// cheerfully reporting a create and an update. Name is identity here (the
    /// NOCASE unique index), so this collision is the review's to catch and not
    /// the database's.
    /// </para>
    /// <para>
    /// Case-insensitive and trimmed, because that is what the index means by
    /// "the same name". Comparing against earlier rows only, so the row that
    /// arrived first keeps its ordinary badge and exactly one of the pair is
    /// flagged.
    /// </para>
    /// </summary>
    private int? FirstUseOf(int index)
    {
        if (scanRows is null) return null;

        var name = scanRows[index].Name.Trim();
        if (name.Length == 0) return null;

        for (var earlier = 0; earlier < index; earlier++)
        {
            if (string.Equals(scanRows[earlier].Name.Trim(), name, StringComparison.OrdinalIgnoreCase))
            {
                return earlier + 1;
            }
        }

        return null;
    }

    private async Task ConfirmScanAsync()
    {
        if (scanRows is null || confirming) return;

        var rows = scanRows
            .Where(r => r.Keep && !string.IsNullOrWhiteSpace(r.Name))
            .ToList();
        if (rows.Count == 0) return;

        confirming = true;
        var created = 0;
        var updated = 0;
        var unchanged = 0;
        // What has actually landed, so a failure part-way can drop them from the
        // review. Rows, not names: the name box is editable and this list has to
        // keep pointing at the same objects the <ul> is keyed on.
        var written = new List<ScanRow>();

        try
        {
            // Sequentially, and deliberately. Each upsert publishes to every
            // circuit before it returns, and the auto-categorizer batches what
            // it hears — a receipt's worth of names arriving one after another
            // is exactly the burst its window was measured against. Firing them
            // in parallel would also put a dozen writers on one SQLite file for
            // no gain: the service's retry exists for household members racing
            // each other, not for the page racing itself.
            foreach (var row in rows)
            {
                // No category and no notes: null leaves an existing row's
                // category alone and lands a new one in Other, where the
                // categorizer picks it up. Passing a guess here would take
                // classification away from the one service that owns it.
                var change = await Svc.UpsertAsync(row.Name, row.Quantity);
                ExpandCategory(change.Category);
                written.Add(row);
                // Three outcomes, not two. UpsertAsync answers Unchanged when
                // the quantity is identical and no category or note moved —
                // which is exactly this call's shape, since it passes neither —
                // so re-confirming a receipt reported "Updated 3 items" for
                // three writes that changed nothing. Same mistake as
                // Describe()'s old `when` ladder, one caller over: a branch
                // that has to cover an outcome it never names ends up
                // announcing some other one.
                switch (change.Kind)
                {
                    case ChangeKind.Created: created++; break;
                    case ChangeKind.Updated: updated++; break;
                    default: unchanged++; break;
                }
            }
        }
        catch (Exception ex)
        {
            // A write that exhausted its retries. Whatever landed has landed, so
            // drop those rows from the review: leaving them would make "the rest
            // are still listed" false, and a second confirm would re-upsert
            // every row that had already succeeded.
            Logger.LogWarning(ex, "Could not finish adding a scanned receipt");
            confirming = false;
            scanRows?.RemoveAll(written.Contains);
            // The captures for the pruned rows go with them; the survivors
            // re-capture on this render.
            scanNameRefs.Clear();
            focusScanName = null;
            scanError = $"Stopped after {Plural(written.Count, "line")}. "
                + "The rest are still listed — try again.";
            return;
        }

        confirming = false;
        scanRows = null;
        scanError = null;
        scanNameRefs.Clear();
        focusScanName = null;
        ShowStatus(DescribeScan(created, updated, unchanged));
    }

    /// <summary>
    /// One clause per outcome that happened, the shape
    /// <see cref="InventoryChange.Describe"/> settled on and for the same
    /// reason: a ladder picking a single headline has to render every
    /// combination it lacks a branch for as some other outcome's non-event,
    /// which is how "Updated 1 item" came to describe a write that changed
    /// nothing. A zero is never a clause.
    /// </summary>
    private static string DescribeScan(int created, int updated, int unchanged)
    {
        // Nothing moved at all: say that, rather than reporting the count as
        // work done. It is the honest answer to re-scanning last week's receipt.
        if (created == 0 && updated == 0)
        {
            return $"{Plural(unchanged, "line")} from the receipt already matched the kitchen";
        }

        var clauses = new List<string>();
        if (created > 0) clauses.Add($"Added {Plural(created, "item")}");
        if (updated > 0) clauses.Add(clauses.Count == 0 ? $"Updated {Plural(updated, "item")}" : $"updated {updated}");
        if (unchanged > 0) clauses.Add($"{unchanged} already up to date");

        return $"{string.Join(", ", clauses)} from the receipt";
    }

    private static string Plural(int count, string noun) =>
        count == 1 ? $"1 {noun}" : $"{count} {noun}s";

    // For an aria-label on a row whose name box may be empty, or may be being
    // retyped one character at a time.
    private static string DisplayName(string name, int position) =>
        string.IsNullOrWhiteSpace(name) ? $"line {position}" : name;

    private static string DisplayFileName(string? contentType) =>
        string.IsNullOrWhiteSpace(contentType) ? "those" : contentType;

    public void Dispose()
    {
        statusCts?.Cancel();
        statusCts?.Dispose();
        // A scan outlives the click that started it, so a circuit torn down
        // mid-read would otherwise leave a claude process holding a pipe
        // nobody is reading.
        scanCts?.Cancel();
        scanCts?.Dispose();
        Notifier.Unsubscribe(OnInventoryChangedAsync);
        Logger.LogDebug("Inventory disposed. instance={Instance}", GetHashCode());
    }

    // The hint describes the write, not the row. Once the user edits a box the
    // two diverge — and this line is the only warning of what Add is about to
    // overwrite, so it saying "· infinite" while Update writes "half a jar"
    // defeats the point of having it. Same "before → after" idiom as
    // InventoryChange.Describe(), which reports the same edit after the fact.
    private string HintCategory() =>
        matchedItem is null || newCategory == matchedItem.Category
            ? Pretty(newCategory)
            : $"{Pretty(matchedItem.Category)} → {Pretty(newCategory)}";

    private string HintQuantity() =>
        matchedItem is null || newQuantity == matchedItem.Quantity
            ? DisplayQuantity(newQuantity)
            : $"{DisplayQuantity(matchedItem.Quantity)} → {DisplayQuantity(newQuantity)}";

    // Matches InventoryChange.Describe()'s wording for an empty quantity, so
    // the hint and the status line below it don't call the same thing two
    // different things.
    // Empty unless the note is actually changing — see the hint markup. Leads
    // with the separator so the caller can concatenate it without a dangling "·"
    // on the common path.
    private string HintNotes() =>
        matchedItem is null || newNotes == (matchedItem.Notes ?? string.Empty)
            ? string.Empty
            : $" · {DisplayNotes(matchedItem.Notes)} → {DisplayNotes(newNotes)}";

    private static string DisplayNotes(string? notes) =>
        string.IsNullOrEmpty(notes) ? "no note" : notes;

    private static string DisplayQuantity(string quantity) =>
        string.IsNullOrEmpty(quantity) ? "unspecified" : quantity;

    private static string Pretty(IngredientCategory c) => c switch
    {
        IngredientCategory.FreshHerbs => "Fresh Herbs",
        IngredientCategory.DrySeasonings => "Dry Seasonings",
        IngredientCategory.MeatAndSeafood => "Meat & Seafood",
        _ => c.ToString(),
    };
}
