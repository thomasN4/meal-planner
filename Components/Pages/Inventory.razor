@page "/inventory"
@rendermode InteractiveServer
@implements IDisposable
@using MealPlanner.Models
@using MealPlanner.Services
@inject InventoryService Svc
@inject InventoryChangeNotifier Notifier
@inject ILogger<Inventory> Logger

<PageTitle>Inventory</PageTitle>

<h1>Kitchen Inventory</h1>
<p class="text-muted">What the kitchen has on hand. Claude reads and updates this too.</p>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label mb-1" for="new-name">Ingredient</label>
                @* The wrapper is the positioning anchor for the suggestion
                   list, which would otherwise hang off the card. *@
                <div class="name-combobox">
                    @* @bind:after, not a separate @oninput: a handler cannot
                       share the event with @bind, and rewriting this to
                       value=/@oninput would put the Add button's disabled
                       state on a field the handler has to remember to assign.
                       @bind:event="oninput" stays exactly as AGENTS.md
                       describes it — the per-keystroke round trip now drives
                       matching too, which is more reason to keep it. *@
                    <input class="form-control" id="new-name" placeholder="e.g. Coriander"
                           maxlength="100" autocomplete="off"
                           @bind="newName" @bind:event="oninput" @bind:after="OnNameChanged"
                           @onkeydown="OnNameKeyDownAsync"
                           @onblur="CloseSuggestions"
                           role="combobox" aria-autocomplete="list"
                           aria-expanded="@(IsListOpen ? "true" : "false")"
                           aria-controls="@(IsListOpen ? SuggestionListId : null)"
                           aria-activedescendant="@ActiveOptionId"/>
                    @if (IsListOpen)
                    {
                        @* preventDefault on mousedown rather than a timer on
                           blur: it stops the input losing focus at all, so
                           @onblur never fires ahead of the click that picks a
                           row. On the <ul> too, for clicks that land on the
                           padding or the scrollbar. *@
                        <ul class="name-suggestions" id="@SuggestionListId" role="listbox"
                            aria-label="Matching ingredients" @onmousedown:preventDefault>
                            @for (var index = 0; index < suggestions.Count; index++)
                            {
                                var item = suggestions[index];
                                var isActive = index == highlightedIndex;
                                @* aria-selected is a string for the same
                                   reason as the accordion's aria-expanded:
                                   Blazor drops a false bool attribute. *@
                                <li class="name-suggestion @(isActive ? "highlighted" : null)"
                                    id="@OptionId(index)" role="option"
                                    aria-selected="@(isActive ? "true" : "false")"
                                    @key="item.Id" @onmousedown:preventDefault
                                    @onclick="() => ApplySuggestion(item)">
                                    <span>@item.Name</span>
                                    <span class="text-muted small">@Pretty(item.Category)</span>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1" for="new-category">Category</label>
                <select class="form-select" id="new-category"
                        @bind="newCategory" @bind:after="OnCategoryTouched">
                    @foreach (var c in Enum.GetValues<IngredientCategory>())
                    {
                        <option value="@c">@Pretty(c)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label mb-1" for="new-quantity">Quantity</label>
                <input class="form-control" id="new-quantity" placeholder="e.g. 2 bags"
                       @bind="newQuantity" @bind:after="OnQuantityTouched" maxlength="50"/>
            </div>
            <div class="col-md-2">
                @* "Update" once the name lands on an existing row: the
                   strongest available statement that Add is about to
                   overwrite something rather than create it. *@
                <button class="btn btn-primary w-100" @onclick="AddAsync"
                        disabled="@string.IsNullOrWhiteSpace(newName)">@(matchedItem is null ? "Add" : "Update")</button>
            </div>
        </div>
        @* Outside the row on purpose: the row is align-items-end, so anything
           added under the input inside its own column lifts that input out of
           line with the other three. Live, but deliberately not role=status —
           the add-result region below owns that role, and more than one
           element answering to it would break the page's own tests. *@
        <div class="name-hint" aria-live="polite">
            @if (matchedItem is not null)
            {
                <span>Updating <strong>@matchedItem.Name</strong> — @HintCategory() · @HintQuantity()</span>
            }
        </div>
        @* The live region stays in the DOM and only its contents change —
           screen readers announce mutations inside a region they already know
           about, not one that arrives with its text already in it. Empty, the
           wrapper has no height, so the margin lives on the alert. *@
        <div role="status">
            @if (statusMessage is not null)
            {
                <div class="alert alert-success py-2 mt-3 mb-0">@statusMessage</div>
            }
        </div>
    </div>
</div>

@if (items is null)
{
    <p><em>Loading…</em></p>
}
else if (items.Count == 0)
{
    <p class="text-muted">Nothing tracked yet. Add something above, or ask Claude to stock the kitchen.</p>
}
else
{
    @foreach (var group in items.GroupBy(i => i.Category).OrderBy(g => g.Key))
    {
        var category = group.Key;
        var isOpen = expandedCategories.Contains(category);
        @* Key the group too: without it, deleting the last item in a category
           shifts the ones below onto the DOM of the group above, which lands a
           focus ring on a header nobody clicked — the row bug one level up. *@
        <div class="category-group mt-3" @key="category">
            @* Heading wraps the button, not the reverse: a button takes phrasing
               content only, and the categories belong in the heading outline.
               aria-expanded must be a string — Blazor drops a false bool
               attribute entirely, so the collapsed state went unannounced. *@
            <h5 class="mb-0">
                <button type="button"
                        class="category-toggle btn btn-link text-decoration-none p-0 d-flex align-items-center gap-2 w-100"
                        @onclick="() => ToggleCategory(category)"
                        aria-expanded="@(isOpen ? "true" : "false")">
                    <span class="category-chevron @(isOpen ? "open" : null)" aria-hidden="true">▸</span>
                    <span class="category-label">@Pretty(category)</span>
                    <span class="text-muted small">(@group.Count())</span>
                </button>
            </h5>
            @if (isOpen)
            {
                <table class="table table-sm align-middle mt-2">
                    <tbody>
                    @foreach (var item in group.OrderBy(i => i.Name))
                    {
                        @* Key by id so a deleted row's DOM (and its focus) is
                           torn down rather than patched onto the next item —
                           otherwise the blue ring on ✕ sticks to the survivor. *@
                        <tr @key="item.Id">
                            <td style="width: 30%">@item.Name</td>
                            <td style="width: 25%">
                                <input class="form-control form-control-sm"
                                       value="@item.Quantity"
                                       placeholder="e.g. 2 bags" maxlength="50"
                                       @onchange="e => ChangeQuantityAsync(item, e)"/>
                            </td>
                            <td style="width: 20%">
                                <select class="form-select form-select-sm"
                                        value="@item.Category"
                                        aria-label="Category for @item.Name"
                                        @onchange="e => ChangeCategoryAsync(item, e)">
                                    @foreach (var c in Enum.GetValues<IngredientCategory>())
                                    {
                                        <option value="@c">@Pretty(c)</option>
                                    }
                                </select>
                            </td>
                            <td class="text-muted small">@item.Notes</td>
                            <td style="width: 1%">
                                <button class="btn btn-outline-danger btn-sm item-remove"
                                        @onclick="() => DeleteAsync(item.Id)"
                                        aria-label="Remove @item.Name">✕</button>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    }
}

@code {
    private List<InventoryItem>? items;
    private string newName = string.Empty;
    private IngredientCategory newCategory = IngredientCategory.Other;
    private string newQuantity = string.Empty;
    private string? statusMessage;
    private CancellationTokenSource? statusCts;
    private static readonly TimeSpan StatusDuration = TimeSpan.FromSeconds(3);
    // Categories start collapsed; only ones the user opens stay open across
    // live refreshes (MCP / other circuits). HashSet so toggle is O(1).
    private readonly HashSet<IngredientCategory> expandedCategories = [];

    // Name-matching state. All of it is derived from `items` and `newName`, but
    // it is stored rather than recomputed at render time so the highlight
    // survives a re-render and the matcher runs once per change, not per paint.
    private IReadOnlyList<InventoryItem> suggestions = [];
    private int highlightedIndex = -1;   // -1 = nothing highlighted, Enter adds
    private bool suggestionsDismissed;   // Escape or blur; typing clears it
    private InventoryItem? matchedItem;  // the row an exact name is editing
    // Autofill writes only into boxes the user has left alone. Both flip the
    // moment the user commits a value of their own, and reset on add.
    private bool categoryTouched;
    private bool quantityTouched;

    private const string SuggestionListId = "name-suggestions";

    private bool IsListOpen => suggestions.Count > 0 && !suggestionsDismissed;
    private string? ActiveOptionId => highlightedIndex >= 0 ? OptionId(highlightedIndex) : null;
    private static string OptionId(int index) => $"name-suggestion-{index}";

    protected override void OnInitialized()
    {
        // The single refresh path for this page: out-of-circuit writers (MCP /
        // Claude) and this circuit's own handlers all publish here, and the
        // re-render happens on the circuit's sync context so the table tracks
        // the kitchen live. The handlers below deliberately do not refresh
        // themselves — the service awaits this publish, so by the time a write
        // returns the table is already current (issue #1).
        Notifier.Subscribe(OnInventoryChangedAsync);
        Logger.LogDebug("Inventory initialized. instance={Instance}", GetHashCode());
    }

    protected override async Task OnInitializedAsync() => await RefreshAsync();

    // Returns the task rather than dropping it, so a failed refresh surfaces to
    // the notifier's guard and gets logged instead of vanishing.
    private Task OnInventoryChangedAsync(InventoryChange change) =>
        InvokeAsync(async () =>
        {
            // PreviousCategory is set only by SetCategoryAsync, i.e. only when a
            // row has just moved groups — the auto-categorizer's second write a
            // few seconds after an add, or someone's dropdown. Open the
            // destination, or the item silently vanishes into a collapsed
            // category right after the user watched it land in Other.
            if (change.PreviousCategory is not null)
            {
                ExpandCategory(change.Category);
            }

            await RefreshAsync();
            // The row the name box is pointing at may be the one that just
            // changed — an MCP tool or another tab can create it, delete it or
            // re-quantify it. Re-deriving keeps the hint honest; leaving it
            // stale would put "Updating Salt · 1 box" above an empty Quantity
            // field that Add would then write back as empty, which is the
            // exact footgun this whole feature exists to close.
            SyncToName();
            StateHasChanged();
        });

    private async Task RefreshAsync() => items = await Svc.GetAllAsync();

    // The one place the matching rule lives. Called from the name box's
    // @bind:after and from the notifier above, so a live write and a keystroke
    // land the form in the same state.
    private void SyncToName()
    {
        suggestions = IngredientMatcher.Suggest(items, newName);
        // Every recompute drops the highlight: the list under the box has just
        // changed, so an index into the old one points at the wrong row, and
        // Enter must go back to meaning "add" until the user arrows on purpose.
        highlightedIndex = -1;

        var match = IngredientMatcher.ExactMatch(items, newName);
        if (match is not null)
        {
            if (!categoryTouched) newCategory = match.Category;
            if (!quantityTouched) newQuantity = match.Quantity;
        }
        else if (matchedItem is not null)
        {
            // Only on the match → no-match transition. A name that never
            // matched anything must not have the form emptied out underneath
            // it while the user is still typing it.
            if (!categoryTouched) newCategory = IngredientCategory.Other;
            if (!quantityTouched) newQuantity = string.Empty;
        }

        matchedItem = match;
    }

    // Typing reopens a list that Escape or a blur closed.
    private void OnNameChanged()
    {
        suggestionsDismissed = false;
        SyncToName();
    }

    private void OnCategoryTouched() => categoryTouched = true;

    private void OnQuantityTouched() => quantityTouched = true;

    private async Task OnNameKeyDownAsync(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                MoveHighlight(1);
                break;
            case "ArrowUp":
                MoveHighlight(-1);
                break;
            case "Escape":
                CloseSuggestions();
                break;
            case "Enter" when highlightedIndex >= 0 && highlightedIndex < suggestions.Count:
                ApplySuggestion(suggestions[highlightedIndex]);
                break;
            case "Enter":
                // Unchanged from before suggestions existed: with nothing
                // arrowed onto, Enter still adds. That is the muscle memory
                // the page already has.
                await AddAsync();
                break;
        }
    }

    // Cycles -1, 0 … n-1 and wraps. -1 stays reachable on purpose: it is how
    // the user gets back to "Enter adds what I typed" without pressing Escape.
    private void MoveHighlight(int delta)
    {
        suggestionsDismissed = false;
        if (suggestions.Count == 0) return;

        var slots = suggestions.Count + 1;
        highlightedIndex = (((highlightedIndex + 1 + delta) % slots + slots) % slots) - 1;
    }

    private void CloseSuggestions()
    {
        suggestionsDismissed = true;
        highlightedIndex = -1;
    }

    private void ApplySuggestion(InventoryItem item)
    {
        newName = item.Name;
        // An explicit pick clears both flags: choosing a row by hand says
        // "I mean this one" in a way that typing a near-miss never does.
        categoryTouched = false;
        quantityTouched = false;
        SyncToName();
        // The name is an exact match now, so Suggest drops it — but a longer
        // name may still have it as a prefix ("Salt" → "Salted butter"), and
        // the user is done choosing either way.
        suggestionsDismissed = true;
    }

    private void ToggleCategory(IngredientCategory category)
    {
        if (!expandedCategories.Remove(category))
        {
            expandedCategories.Add(category);
        }
    }

    // Ensure the destination is visible so the user sees the row land there.
    private void ExpandCategory(IngredientCategory category) =>
        expandedCategories.Add(category);

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        var change = await Svc.UpsertAsync(newName, newQuantity, newCategory);
        // Use the returned category: upsert can land on an existing row whose
        // category differs from what the form still held. Still needed despite
        // the notifier: an upsert reports no PreviousCategory, so a create has
        // nothing there to recognise as a move.
        ExpandCategory(change.Category);
        // Clear the form before showing the status, never after: the dismissal
        // delay used to be awaited here, which left the just-added name sitting
        // in the box for a full three seconds and then wiped whatever had been
        // typed in the meantime.
        newName = string.Empty;
        newQuantity = string.Empty;
        // Reset too: a category left over from the last add silently attached
        // itself to the next ingredient, which is most of why everything ended
        // up needing sorting out by hand in the first place.
        newCategory = IngredientCategory.Other;
        // After the await, never before: the upsert above publishes, and the
        // notifier handler runs SyncToName() while newName still holds the
        // name that was typed. Resetting first would just be undone.
        ResetMatchState();
        ShowStatus(change.Describe());
    }

    private void ResetMatchState()
    {
        suggestions = [];
        highlightedIndex = -1;
        suggestionsDismissed = false;
        matchedItem = null;
        categoryTouched = false;
        quantityTouched = false;
    }

    // Ephemeral success line under the add form. A new add cancels the previous
    // timer so rapid entry never leaves a stale message behind.
    private void ShowStatus(string message)
    {
        statusCts?.Cancel();
        statusCts?.Dispose();
        statusCts = new CancellationTokenSource();

        statusMessage = message;
        // Paint it now. A handler re-renders only at its first incomplete await
        // and again on completion, so a message set and cleared between those
        // two points never reaches the browser — which is exactly what happened
        // once the write above yielded for real (a second circuit subscribed to
        // the notifier is enough to move the first yield earlier).
        StateHasChanged();

        // The one deliberately unawaited call on this page. AGENTS.md bans
        // fire-and-forget because it loses the re-render and swallows
        // exceptions; both are handled explicitly in the method below, and the
        // timer has to outlive the handler or the add form freezes again.
        _ = DismissStatusAsync(statusCts.Token);
    }

    private async Task DismissStatusAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(StatusDuration, token);
            statusMessage = null;
            // Nothing else is rendering by now — the handler that showed the
            // message finished long ago — so ask for the pass ourselves.
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // The next add, or disposal — expected.
        }
        catch (Exception ex)
        {
            // Nothing awaits this task, so an exception here would vanish. A
            // stale alert is harmless; losing the reason for it is not.
            Logger.LogWarning(ex, "Could not clear the inventory status message");
        }
    }

    private async Task ChangeQuantityAsync(InventoryItem item, ChangeEventArgs e)
    {
        await Svc.UpsertAsync(item.Name, e.Value?.ToString() ?? "", item.Category);
    }

    // The row jumps to another group on the re-render, because the table is
    // grouped by category — that is the confirmation the change landed.
    private async Task ChangeCategoryAsync(InventoryItem item, ChangeEventArgs e)
    {
        if (!Enum.TryParse<IngredientCategory>(e.Value?.ToString(), out var category)
            || !Enum.IsDefined(category))
        {
            return;
        }

        // No ExpandCategory here: this write publishes, and the notifier above
        // opens the destination for every category move, wherever it came from.
        await Svc.SetCategoryAsync(item.Name, category);
    }

    private async Task DeleteAsync(int id)
    {
        await Svc.DeleteAsync(id);
    }

    public void Dispose()
    {
        statusCts?.Cancel();
        statusCts?.Dispose();
        Notifier.Unsubscribe(OnInventoryChangedAsync);
        Logger.LogDebug("Inventory disposed. instance={Instance}", GetHashCode());
    }

    // The hint describes the write, not the row. Once the user edits a box the
    // two diverge — and this line is the only warning of what Add is about to
    // overwrite, so it saying "· infinite" while Update writes "half a jar"
    // defeats the point of having it. Same "before → after" idiom as
    // InventoryChange.Describe(), which reports the same edit after the fact.
    private string HintCategory() =>
        matchedItem is null || newCategory == matchedItem.Category
            ? Pretty(newCategory)
            : $"{Pretty(matchedItem.Category)} → {Pretty(newCategory)}";

    private string HintQuantity() =>
        matchedItem is null || newQuantity == matchedItem.Quantity
            ? DisplayQuantity(newQuantity)
            : $"{DisplayQuantity(matchedItem.Quantity)} → {DisplayQuantity(newQuantity)}";

    // Matches InventoryChange.Describe()'s wording for an empty quantity, so
    // the hint and the status line below it don't call the same thing two
    // different things.
    private static string DisplayQuantity(string quantity) =>
        string.IsNullOrEmpty(quantity) ? "unspecified" : quantity;

    private static string Pretty(IngredientCategory c) => c switch
    {
        IngredientCategory.FreshHerbs => "Fresh Herbs",
        IngredientCategory.DrySeasonings => "Dry Seasonings",
        IngredientCategory.MeatAndSeafood => "Meat & Seafood",
        _ => c.ToString(),
    };
}
