{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MealPlanner": "Data Source=mealplanner.db"
  },
  "Categorization": {
    "Enabled": true,
    "ExecutablePath": "claude",
    "Model": "sonnet",
    "Effort": "low",
    "TimeoutSeconds": 90,
    "MaxBatchSize": 20,
    "BatchWindowMilliseconds": 400,
    "CacheSize": 500
  },
  "RecipeGeneration": {
    "Enabled": true,
    "ExecutablePath": "claude",
    "Model": "sonnet",
    "Effort": "medium",
    "TimeoutSeconds": 180
  },
  "ReceiptScanning": {
    "Enabled": true,
    "ExecutablePath": "claude",
    "Model": "sonnet",
    "Effort": "low",
    "TimeoutSeconds": 120,
    "MaxBytes": 5242880,
    "MaxLines": 60
  }
}
